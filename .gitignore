# ─── Dependencies ────────────────────────────────────────
# All three node_modules/ directories (root, server, client).
# Fully regenerated by `npm install` + `npm run install:all`.
node_modules/

# ─── SQLite Database Files ───────────────────────────────
# Auto-created on first server start. Schema is in server/db.js.
# WAL and SHM are SQLite journaling files.
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm

# ─── Build Output ────────────────────────────────────────
# Generated by `npm run build` in the client. Not needed for dev.
dist/
client/dist/

# ─── Lock Files (keep package-lock.json, ignore others) ──
# package-lock.json IS committed — it pins exact versions.
# But yarn/pnpm lock files should be ignored if present.
yarn.lock
pnpm-lock.yaml

# ─── Environment Variables ───────────────────────────────
# Could contain secrets. Never commit.
.env
.env.local
.env.*.local

# ─── OS Files ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor / IDE Files ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Logs ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
